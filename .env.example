# Hybrid workspace. Demo records load only when you choose "Load 5 demo brands".
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
APP_URL=http://localhost:3000

# Parallax workspace login. Required for production; local preview accepts any valid email and
# password with at least 8 characters when these values are empty.
PARALLAX_LOGIN_EMAIL=
PARALLAX_LOGIN_PASSWORD=
PARALLAX_SESSION_SECRET=

# Supabase (optional in demo mode)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=

# Google / YouTube OAuth.
# Enable youtube.googleapis.com and youtubeanalytics.googleapis.com in Google Cloud.
# Live Streaming resources are part of the YouTube Data API v3 service.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback

# AI commentary (optional; deterministic mock provider is the default)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# AI Visibility (optional; unconfigured surfaces are clearly labelled in the UI)
# OPENAI_API_KEY/OPENAI_MODEL above also power the OpenAI web-search check.
SERPAPI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Email (optional; local preview/log mode is the default)
MAIL_PROVIDER=preview
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=reports@parallax.local
